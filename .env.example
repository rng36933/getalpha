# Copy to .env and fill in. Never commit the filled-in .env — it is git-ignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The connection the running app uses. In production this must be the POOLED
# endpoint, because each serverless instance opens its own connection:
#   Neon      -> the host containing "-pooler"
#   Supabase  -> port 6543 (the PgBouncer port), with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# The connection Prisma migrations use. Must be the UNPOOLED endpoint — a
# transaction pooler cannot run the DDL and advisory locks migrations need.
# Locally, leave this unset and DATABASE_URL is used instead.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Only needed for `prisma migrate dev` against a local database.
# SHADOW_DATABASE_URL="postgresql://user:password@host:5433/dbname"

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# From dashboard.clerk.com -> your application -> API Keys.
# The publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# This app uses /login and /register rather than Clerk's defaults.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# Clerk dashboard -> Configure -> Webhooks -> add an endpoint at
# /api/webhooks/clerk subscribed to `user.deleted`, then copy its Signing
# Secret. Without this the route refuses every request, and an account deleted
# in Clerk would leave its trades and subscription behind here — which the
# privacy policy promises does not happen.
CLERK_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# twelvedata.com -> free plan, 800 requests/day. Used for the daily bars the
# pivot levels are computed from.
TWELVE_DATA_API_KEY="..."

# The economic calendar needs no key: it comes from the public ForexFactory
# weekly feed. News needs no key either — plain RSS.

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Create at console.anthropic.com -> API Keys. The account needs credit.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional override, so a retired model can be swapped without a deploy.
# Defaults to claude-opus-5. A model with no entry in the pricing table is
# billed at the highest known rate, so the daily cap stays conservative.
# ANTHROPIC_MODEL="claude-opus-5"

# Hard ceiling on AI spend per UTC day, in USD. AI routes return HTTP 402
# once today's spend plus the next call's worst case would exceed it.
# Defaults to 2 when unset. One AI Coach review costs roughly $0.11.
AI_DAILY_BUDGET_USD="2"

# ---------------------------------------------------------------------------
# Stripe (subscriptions)
# ---------------------------------------------------------------------------
# dashboard.stripe.com -> Developers -> API keys, with the "Test mode" toggle
# ON. Test keys start sk_test_ / pk_test_ and move no real money. Stripe has no
# monthly fee — it only takes a cut of live payments, so test mode costs
# nothing at all.
STRIPE_SECRET_KEY="sk_test_..."

# Verifies that a webhook really came from Stripe. Two different secrets:
#   local  -> printed by `stripe listen --forward-to localhost:3000/api/billing/webhook`
#   hosted -> Developers -> Webhooks -> your endpoint -> Signing secret
# Using the wrong one makes every webhook fail with 400 Invalid signature.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ids from Product catalogue -> your product -> Pricing. These start
# `price_`, NOT `prod_`. The amounts live in Stripe, not in the code — the
# pricing page reads them back, so changing what you charge needs no deploy.
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."

# Where Stripe sends the browser back to after checkout. Leave unset locally
# and the request's own origin is used; set it in production so a checkout
# started on a preview deployment still returns to the real site.
NEXT_PUBLIC_APP_URL="https://www.getalpha.org"

# ---------------------------------------------------------------------------
# PostHog (product analytics)
# ---------------------------------------------------------------------------
# eu.posthog.com -> Project settings -> Project API key. Starts phc_.
# Deliberately not NEXT_PUBLIC_: analytics run server-side only, so no
# collector ever sees a page holding entry prices or account balances.
# Leave unset and analytics are silently skipped — nothing else changes.
POSTHOG_API_KEY="phc_..."

# EU cloud by default. Only change this for a US project or self-hosting.
POSTHOG_HOST="https://eu.i.posthog.com"

# ---------------------------------------------------------------------------
# Resend (the morning brief email)
# ---------------------------------------------------------------------------
# resend.com -> API Keys. Free tier: 3,000 emails a month, 100 a day.
RESEND_API_KEY="re_..."

# Must be on a domain verified in Resend (Domains -> Add domain, then the DNS
# records it gives you). Until one is verified, Resend only accepts
# onboarding@resend.dev and only delivers to the account owner's own address —
# fine for testing the job, useless for real subscribers.
EMAIL_FROM="getALPHA <brief@getalpha.org>"

# Shared secret for the scheduled job. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate a long random string; with
# this unset the cron route refuses every request rather than running open,
# because it spends money on a model call and mails every subscriber.
CRON_SECRET="a-long-random-string"

# ---------------------------------------------------------------------------
# Sentry (error tracking)
# ---------------------------------------------------------------------------
# sentry.io -> your project -> Settings -> Client Keys (DSN).
# NEXT_PUBLIC_ because the browser SDK needs it, and a DSN is designed to be
# public — it can only receive events, never read them. Must NOT be marked
# "Sensitive" in Vercel: NEXT_PUBLIC_ values are inlined at build time and
# Sensitive ones are withheld then, leaving the browser with an empty DSN.
# Leave unset and Sentry is inert.
NEXT_PUBLIC_SENTRY_DSN="https://...@...ingest.de.sentry.io/..."

# Only needed to upload source maps, which turn a minified stack trace into
# real file names and line numbers. Create at Settings -> Auth Tokens with the
# project:releases scope. Server-side only, safe to mark Sensitive.
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="getalpha"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot check on the public waitlist form)
# ---------------------------------------------------------------------------
# Optional. Leave unset and the waitlist works without a bot check; set it and
# the check becomes mandatory, so it cannot half-apply. Turnstile rather than
# reCAPTCHA because it sets no cookie and does not profile the visitor, which
# keeps the privacy policy's "no third-party trackers" true.
# dash.cloudflare.com -> Turnstile -> Add site.
TURNSTILE_SECRET_KEY=""
