// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TradeDirection {
  BUY
  SELL
}

enum AiFeature {
  SESSION_BRIEF
  TRADE_COACH
}

enum TradingSession {
  LONDON
  NEW_YORK
  ASIA
}

enum BriefStatus {
  PENDING
  READY
  FAILED
}

enum InstrumentKind {
  FOREX
  CRYPTO
  COMMODITY
}

/// The searchable instrument catalogue, synced from the data provider.
///
/// Held locally rather than proxying the provider's search: that search ranks
/// "gold" as an Indonesian telecom stock before it reaches XAU/USD, and every
/// keystroke would be a network round trip against a rate-limited plan.
model Instrument {
  /// Provider symbol, e.g. "EUR/USD". Also the natural primary key.
  symbol String @id
  /// Display form without the slash, matching how trades are journalled.
  label  String
  name   String
  kind   InstrumentKind
  /// Provider grouping — "Major", "Exotic-Cross", "Precious Metal".
  group  String?

  /// Hand-set ranking so majors surface above exotics in search.
  popularity Int @default(0)

  updatedAt DateTime @updatedAt

  watchlistItems WatchlistItem[]

  @@index([kind])
  @@index([popularity])
}

/// A user's personal instruments. Drives charts and filters — never the AI
/// Session Brief, which stays a shared desk-wide document.
model WatchlistItem {
  id     String @id @default(uuid())
  userId String

  symbol     String
  instrument Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId, sortOrder])
}

enum SupportKind {
  BUG
  FEEDBACK
  QUESTION
}

enum SupportStatus {
  OPEN
  CLOSED
}

/// A bug report or a piece of feedback from a signed-in user.
///
/// Stored here rather than forwarded to a chat webhook: a message is worth
/// nothing if it scrolls past unread, and a row can be listed, filtered and
/// marked done. Forwarding can be added later on top of this without changing
/// where the record lives.
model SupportTicket {
  id     String @id @default(uuid())
  userId String

  kind    SupportKind
  message String

  /// Which page they were on. The single most useful field on a bug report,
  /// and the one nobody ever includes when asked to type it.
  pageUrl String?

  status SupportStatus @default(OPEN)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Someone who asked to hear about the product before signing up.
model WaitlistEntry {
  id    String @id @default(uuid())
  email String @unique

  /// The referral code in the link they arrived through, if any.
  referredByCode String?

  /// Set when this address later became a real account, so an invite can be
  /// credited to whoever sent the link rather than only to direct sign-ups.
  convertedUserId String?   @unique
  convertedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([referredByCode])
}

/// One row per signed-up user: their invite code, and whose code brought them.
///
/// `code` is random, never sequential. A guessable code lets anyone enumerate
/// every user's invite link and attribute sign-ups to accounts that never sent
/// one.
model Referral {
  id     String @id @default(uuid())
  userId String @unique

  code String @unique

  /// The code of whoever invited them. Not a foreign key on purpose: the
  /// inviter may delete their account, and that must not erase the record of
  /// where an existing user came from.
  referredByCode String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([referredByCode])
}

/// A granted referral bonus — paid access without a payment.
///
/// One row per threshold reached, so passing three invites grants once and
/// passing six later grants again, while re-checking the same threshold does
/// nothing.
model ReferralReward {
  id     String @id @default(uuid())
  userId String

  /// How many qualified invites triggered this grant.
  atInviteCount Int

  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@unique([userId, atInviteCount])
  @@index([userId, expiresAt])
}

/// Proof that a user accepted the legal documents, and which version.
///
/// One row per acceptance, never updated. When a document changes its version
/// changes with it, the existing row stops matching, and the user is asked
/// again — leaving the older row in place as the record of what they agreed to
/// at the time. An overwritten row would destroy exactly the evidence this
/// table exists to hold.
model LegalAcceptance {
  id     String @id @default(uuid())
  userId String

  /// e.g. "terms@2026-07-26|privacy@2026-07-26|disclaimer@2026-07-26".
  documentVersion String

  /// Explicitly `timestamptz`, unlike every other timestamp here.
  ///
  /// Prisma writes UTC into a plain `timestamp` anyway, so the value would be
  /// correct either way — but this column is evidence, and evidence is read by
  /// people who did not write the code. A bare `timestamp` says "some clock,
  /// somewhere"; `timestamptz` says which one, in the database itself.
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, documentVersion])
  @@index([userId, acceptedAt])
}

/// Who wants email, and which kind.
///
/// Opt-in, never opt-out: a row exists only once a user has asked for
/// something. No row means no email, which is the right default for a product
/// that holds an address it was given for authentication, not for marketing.
///
/// The address itself is not stored — Clerk owns it, and a copy here would go
/// stale the first time somebody changes it.
model EmailPreference {
  id     String @id @default(uuid())
  userId String @unique

  /// The morning Session Brief, sent before the London open.
  dailyBrief Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyBrief])
}

/// One row per day the morning email went out.
///
/// The send is idempotent on this: Vercel's scheduler offers no exactly-once
/// guarantee and a Hobby cron fires with up to an hour of jitter, so the job
/// must be safe to run twice. The unique date is what makes it safe.
model DailyBriefEmail {
  /// YYYY-MM-DD in Europe/London — the day the recipient experienced, not UTC.
  briefDate String @id

  sentAt         DateTime @default(now())
  recipientCount Int      @default(0)
  failureCount   Int      @default(0)

  @@index([sentAt])
}

/// Mirrors Stripe's subscription statuses, narrowed to the ones that change
/// what a user can do. Stripe's `unpaid` and `paused` both land on PAST_DUE.
enum SubscriptionStatus {
  /// Paying, or inside a trial. Both grant access.
  ACTIVE
  TRIALING
  /// Payment failed. Stripe keeps retrying, so access is kept for now.
  PAST_DUE
  /// Ended, or never completed checkout. No access.
  CANCELED
  INCOMPLETE
}

/// One row per user who has ever reached Stripe checkout.
///
/// Clerk owns identity, so there is no User table to hang this off — `userId`
/// is the Clerk id and is the join key for the whole app.
model Subscription {
  id     String @id @default(uuid())
  userId String @unique

  /// Created once and reused, so a returning customer keeps one billing
  /// history rather than accumulating duplicate Stripe customers.
  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique

  status   SubscriptionStatus @default(INCOMPLETE)
  /// Which plan they are on, from `plans.ts`. Null before checkout completes.
  planSlug String?
  stripePriceId String?

  /// When the paid period ends. Access survives to this date after cancelling.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Webhook deliveries already applied.
///
/// Stripe retries until it gets a 2xx and explicitly does not promise
/// exactly-once delivery, so without this a retried `checkout.session.completed`
/// would be processed twice.
model ProcessedStripeEvent {
  /// Stripe's event id, e.g. "evt_1234". The primary key is the whole point.
  id String @id

  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

enum MarketDataKind {
  ECONOMIC_CALENDAR
  TECHNICAL_LEVELS
  NEWS_HEADLINES
  PRICE_SERIES
  /// Yields, the dollar index, inflation and policy rates, from FRED.
  MACRO_SERIES
  /// Weekly futures positioning, from the CFTC's own feed.
  COT_POSITIONING
}

/// Last-known-good market data, written on every successful provider fetch.
///
/// This is what makes a provider outage a degraded brief rather than no brief:
/// when the live call fails, the newest row for that kind is served instead.
model MarketDataSnapshot {
  id      String         @id @default(uuid())
  kind    MarketDataKind
  payload Json

  /// Distinguishes rows within a kind that are not interchangeable — the price
  /// series for XAU/USD must never be served as the fallback for EUR/USD.
  /// Null for kinds that have exactly one set, such as the calendar.
  key String?

  fetchedAt DateTime @default(now())

  @@index([kind, key, fetchedAt])
}

/// One brief per trading session per UTC day, shared by every user.
///
/// The unique key is what makes concurrent generation safe: the first request
/// of the morning claims the row, and everyone arriving behind it reads the
/// result instead of paying for a second identical call.
model SessionBriefCache {
  id String @id @default(uuid())

  session TradingSession
  /// YYYY-MM-DD in UTC. A string, so the key cannot drift with timezones.
  briefDate String

  status BriefStatus @default(PENDING)
  /// The SessionBrief payload. Null while PENDING and after a FAILED attempt.
  brief Json?
  /// The exact market data the brief was written from, so a reader can check
  /// what it was based on instead of taking it on faith.
  inputs Json?
  /// True when any source was stale or missing when the brief was generated.
  degraded Boolean @default(false)

  /// When the stored brief was produced — the age the TTL is measured against.
  generatedAt DateTime?
  /// When a generator last took ownership. Lets a crashed attempt be retried.
  claimedAt DateTime @default(now())

  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([session, briefDate])
  @@index([session, generatedAt])
}

/// One row per Anthropic API call. This table is the only source of truth for
/// spend, so the daily limit is only as reliable as its write path.
model AiUsageLog {
  id      String    @id @default(uuid())
  userId  String?
  feature AiFeature

  /// The model that actually served the request — a safety fallback may have
  /// been answered by a different (differently priced) model than requested.
  model String

  inputTokens              Int
  outputTokens             Int
  cacheCreationInputTokens Int @default(0)
  cacheReadInputTokens     Int @default(0)

  costUsd Decimal @db.Decimal(12, 6)

  /// True while a call is in flight and `costUsd` is the worst case rather
  /// than what was actually spent.
  ///
  /// The row is written before the request, under a lock, so two calls issued
  /// at the same moment cannot both read the same "spent so far" and both pass
  /// a limit only one of them fits under.
  pending Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([pending, createdAt])
}

enum TradeSource {
  MANUAL
  MT5
}

/// A terminal allowed to push trades into one account's journal.
///
/// The token is stored as a hash. A leaked database should not hand anyone a
/// working key, and nobody — including us — needs to read it back after it is
/// shown to the user once.
///
/// Note what is deliberately absent: any credential for the broker. The
/// terminal sends to us; we never connect to it, and there is nothing here
/// that could be used to reach somebody's trading account.
model MtConnection {
  id     String @id @default(uuid())
  userId String @unique

  /// SHA-256 of the token, hex encoded.
  tokenHash String @unique

  /// Shown so the user can tell which terminal is connected.
  accountLogin String?
  broker       String?
  currency     String?

  /// When the terminal last sent anything, so a silent EA is visible as silent.
  lastSeenAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([lastSeenAt])
}

model Trade {
  id     String @id @default(uuid())
  userId String

  /// Where the row came from. Manual entries stay editable; synced ones are
  /// overwritten by the terminal on the next update.
  source TradeSource @default(MANUAL)

  /// The MT5 position ticket, for synced trades.
  ///
  /// The position ticket rather than the deal ticket, because a position is one
  /// trade from open to close while its deals are the two ends of it. Keyed
  /// this way, an open position becomes the same row when it closes instead of
  /// a second one — and a terminal that restarts and resends its whole history
  /// updates rows rather than duplicating them, which the unique constraint
  /// enforces rather than a check two concurrent requests could both pass.
  externalId String?

  asset     String
  direction TradeDirection

  // Which playbook entry this was, so reviews can be grouped by setup rather
  // than judged one trade at a time.
  setup     String?
  timeframe String?

  // Prices and size are Decimal, not Float: binary floating point silently
  // corrupts money values (0.1 + 0.2 != 0.3).
  entryPrice Decimal  @db.Decimal(18, 8)
  exitPrice  Decimal? @db.Decimal(18, 8)
  size       Decimal  @db.Decimal(18, 8)
  pnl        Decimal? @db.Decimal(18, 2)

  // Units per unit of `size`. MT5 quotes size in lots, and one XAUUSD lot is
  // 100 ounces — without this, risk in currency is out by that factor and
  // every R-multiple built on it is wrong. Defaults to 1 (size is in units).
  contractSize Decimal @default(1) @db.Decimal(18, 4)

  // The planned trade. Without stopLoss there is no defined risk, so no
  // R-multiple, and any review of sizing or exit discipline is guesswork.
  stopLoss   Decimal? @db.Decimal(18, 8)
  takeProfit Decimal? @db.Decimal(18, 8)

  // Equity at entry — turns absolute risk into risk-percent-of-account.
  accountBalance Decimal? @db.Decimal(18, 2)

  // Optional: a trade can be journalled while it is still open, and the
  // reflection fields are often filled in later.
  marketContext  String?
  emotionalState String?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@unique([userId, externalId])
  @@index([userId, createdAt])
  @@index([asset])
  @@index([userId, setup])
}
